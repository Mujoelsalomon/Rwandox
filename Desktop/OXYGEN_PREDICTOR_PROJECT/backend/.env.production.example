# Production environment example for the Django backend.
# Replace every placeholder before deploying.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=rwandoxy.com,www.rwandoxy.com

# Preferred: Render PostgreSQL Internal Database URL.
DATABASE_URL=postgres://user:password@host:5432/database
DATABASE_SSL_REQUIRE=True

# Optional local fallback, used only when DJANGO_DEBUG=1 and not running on Render.
LOCAL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postop

# Optional production fallback if your platform exposes separate PostgreSQL
# values instead of DATABASE_URL. POSTGRES_HOST must not be localhost or db.
POSTGRES_DB=postop
POSTGRES_USER=postop_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=replace-with-production-postgres-host
POSTGRES_PORT=5432

FRONTEND_ORIGIN=https://rwandoxy.com
CORS_ALLOWED_ORIGINS=https://rwandoxy.com,https://www.rwandoxy.com
CSRF_TRUSTED_ORIGINS=https://rwandoxy.com,https://www.rwandoxy.com

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_USE_X_FORWARDED_PROTO=True

FAST_LOGIN_PBKDF2_ITERATIONS=120000
