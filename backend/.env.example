# Example environment variables for Django + Postgres
POSTGRES_DB=postop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DJANGO_SECRET_KEY=change-me-for-prod
DJANGO_DEBUG=1
FAST_LOGIN_PBKDF2_ITERATIONS=120000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,rwandoxy.com,www.rwandoxy.com
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://rwandoxy.com,https://www.rwandoxy.com
CSRF_TRUSTED_ORIGINS=https://rwandoxy.com,https://www.rwandoxy.com
